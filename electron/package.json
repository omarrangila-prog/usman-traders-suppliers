{
  "name": "usman-traders",
  "productName": "Usman Traders & Suppliers",
  "version": "2.2.1",
  "description": "Trading, stock and accounting for Usman Traders & Suppliers",
  "main": "main.js",
  "author": "Usman Traders & Suppliers",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/figures.js && node test/operations.js && node test/a-day-in-the-shop.js && node test/sharing.js && node test/hostile.js",
    "dist": "electron-builder --win --publish never",
    "selfcheck": "electron . --self-check"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pk.usmantraders.desktop",
    "productName": "Usman Traders & Suppliers",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../static",
        "to": "static"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../static/icon.ico",
      "artifactName": "UsmanTraders-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Usman Traders"
    },
    "portable": {
      "artifactName": "UsmanTraders-Portable-${version}.${ext}"
    }
  }
}
